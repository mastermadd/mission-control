#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
ROOT=/opt/mission-control
REPOSITORY=mastermadd/mission-control
[[ $EUID -eq 0 ]] || { echo 'Run with sudo.'; exit 1; }
[[ -f "$ROOT/config/config.json" ]] || { echo 'Mission Control is not installed.'; exit 1; }
exec 9>"$ROOT/.maintenance.lock"
flock -n 9 || { echo 'Another maintenance operation is running.'; exit 1; }
compose(){ docker compose --project-directory "$ROOT" "$@"; }
backup_stopped(){ local archive="$ROOT/backups/$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM.tar.gz"; tar -czf "$archive" -C "$ROOT" data config .env compose.yaml; chmod 600 "$archive"; printf '%s\n' "$archive"; }
case ${1:-help} in
 status) compose ps; printf 'Revision: '; basename "$(readlink -f "$ROOT/current")";;
 logs) compose logs --tail=100;;
 backup) compose stop >/dev/null; trap 'compose up -d >/dev/null' EXIT; backup_stopped;;
 targets)
  echo 'Enter the entire allowed host:port list (comma-separated).'; read -r TARGETS </dev/tty
  printf '%s' "$TARGETS" | python3 -c 'import json,sys,os; p="/opt/mission-control/config/config.json"; c=json.load(open(p)); c["allowedTargets"]=sys.stdin.read(); tmp=p+".new"; f=open(tmp,"w"); json.dump(c,f,indent=2); f.close(); os.chmod(tmp,0o600); os.chown(tmp,1000,1000); os.replace(tmp,p)'
  compose restart;;
 update)
  WORK=$(mktemp -d); NEED_RESTART=0; trap 'if [[ $NEED_RESTART == 1 ]]; then compose up -d >/dev/null || true; fi; rm -rf "$WORK"' EXIT
  git clone --quiet --depth 1 "https://github.com/$REPOSITORY.git" "$WORK/source"
  REVISION=$(git -C "$WORK/source" rev-parse HEAD); OLD=$(readlink -f "$ROOT/current")
  if [[ "$(basename "$OLD")" == "$REVISION" ]]; then echo 'Already on the latest revision.'; exit 0; fi
  RELEASE="$ROOT/releases/$REVISION"; if [[ ! -d "$RELEASE" ]]; then cp -a "$WORK/source" "$RELEASE"; fi
  IMAGE="jdln-mission-control:$REVISION"
  docker build --pull -t "$IMAGE" "$RELEASE"
  compose stop >/dev/null; NEED_RESTART=1
  BACKUP=$(backup_stopped)
  printf '%s\n' "$OLD" > "$ROOT/previous-release"
  printf '%s\n' "$BACKUP" > "$ROOT/previous-backup"
  cp "$ROOT/.env" "$WORK/old.env"; cp "$ROOT/compose.yaml" "$WORK/old.compose"
  BIND_IP=$(sed -n 's/^MISSION_BIND_IP=//p' "$ROOT/.env"); PORT=$(sed -n 's/^MISSION_PORT=//p' "$ROOT/.env")
  printf 'MISSION_IMAGE=%s\nMISSION_VERSION=%s\nMISSION_BIND_IP=%s\nMISSION_PORT=%s\n' "$IMAGE" "$REVISION" "$BIND_IP" "$PORT" > "$ROOT/.env"
  cp "$RELEASE/compose.yaml" "$ROOT/compose.yaml"
  if ! compose up -d --wait --wait-timeout 90; then
   echo 'Update failed. Restoring the pre-update application and database.'
   compose down >/dev/null
   rm -f "$ROOT/data/mission.sqlite-wal" "$ROOT/data/mission.sqlite-shm"
   tar -xzf "$BACKUP" -C "$ROOT"
   compose up -d --wait --wait-timeout 90
   exit 1
  fi
  NEED_RESTART=0
  rm -f "$ROOT/current.new"
  ln -s "$RELEASE" "$ROOT/current.new"; mv -Tf "$ROOT/current.new" "$ROOT/current"
  install -m 0755 "$RELEASE/mission-control" /usr/local/bin/mission-control
  echo "Updated to $REVISION. Pre-update backup: $BACKUP";;
 rollback)
  [[ -f "$ROOT/previous-release" && -f "$ROOT/previous-backup" ]] || { echo 'No previous update available.'; exit 1; }
  echo 'Rollback restores the database from before the last update. Changes made after that update will be removed.'
  read -r -p 'Type RESTORE to continue: ' ANSWER </dev/tty
  [[ "$ANSWER" == RESTORE ]] || exit 1
  OLD=$(cat "$ROOT/previous-release"); BACKUP=$(cat "$ROOT/previous-backup")
  [[ -d "$OLD" && -f "$BACKUP" ]] || { echo 'Previous release or backup is missing.'; exit 1; }
  compose stop >/dev/null; SAFETY=$(backup_stopped); compose down >/dev/null
  rm -f "$ROOT/data/mission.sqlite-wal" "$ROOT/data/mission.sqlite-shm"
   tar -xzf "$BACKUP" -C "$ROOT"
  compose up -d --wait --wait-timeout 90
  rm -f "$ROOT/current.new"
  ln -s "$OLD" "$ROOT/current.new"; mv -Tf "$ROOT/current.new" "$ROOT/current"
  install -m 0755 "$OLD/mission-control" /usr/local/bin/mission-control
  echo "Restored previous release. Backup of the replaced state: $SAFETY";;
 *) echo 'Usage: sudo mission-control {status|logs|update|backup|rollback|targets}';;
esac
